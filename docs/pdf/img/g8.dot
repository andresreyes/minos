        fontcolor="#1F2933", height=0.46];
  edge [color="#718096", arrowsize=0.6, fontsize=8, fontname="DejaVu Sans", fontcolor="#4A5568"];

  X  [label="agentic-patterns-\ntypescript\nsin licencia", fillcolor="#FFF5F5", color="#C53030", fontcolor="#742A2A"];
  S5 [label="Coder\nplataforma", fillcolor="#EBF4FF", color="#2B6CB0"];
  S4 [label="AGENTS.md\nLinux Foundation", fillcolor="#EBF4FF", color="#2B6CB0"];
  S3 [label="github/spec-kit\nMIT", fillcolor="#EBF4FF", color="#2B6CB0"];
  S2 [label="cloudflare/\nsecurity-audit-skill\nMIT", fillcolor="#EBF4FF", color="#2B6CB0"];
