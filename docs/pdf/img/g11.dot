digraph cuatroR {
  rankdir=LR; bgcolor="white";
  graph [fontname="DejaVu Sans", nodesep=0.18, ranksep=0.8];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=9.5,
        fontcolor="#1F2933", height=0.44];
  edge [color="#718096", arrowsize=0.6];

  R4 [label="RANKING", fillcolor="#EBF4FF", color="#2B6CB0"];
  R3 [label="RECUPERACIÓN", fillcolor="#EBF4FF", color="#2B6CB0"];
  R2 [label="RECENCIA", fillcolor="#EBF4FF", color="#2B6CB0"];
R1 [label="RELEVANCIA", fillcolor="#EBF4FF", color="#2B6CB0"];

  Q4 [label="dónde se coloca\n«¿lo importante está donde se ve?»", fillcolor="#F0FFF4", color="#2F855A"];
  Q3 [label="cuándo entra\n«¿siempre, o solo si lo piden?»", fillcolor="#F0FFF4", color="#2F855A"];
  Q2 [label="qué sale\n«¿lo viejo se muere o se acumula?»", fillcolor="#F0FFF4", color="#2F855A"];
Q1 [label="qué entra\n«si quito esto, ¿cambia algo?»", fillcolor="#F0FFF4", color="#2F855A"];

  R4->Q4; R3->Q3; R2->Q2; R1->Q1;
}
